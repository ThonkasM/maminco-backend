# ============================================
# DATABASE
# ============================================
# PostgreSQL (local o Docker). Requerido.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maminco_dev?schema=public"

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# AUTH (REQUERIDO)
# ============================================
# Obligatorio. Mínimo 32 caracteres. La app no arranca sin esto.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
# Lista separada por comas. Si se omite, usa localhost por defecto.
# CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# ============================================
# SERVICIO DE IA (opcional por ahora)
# ============================================
# Token compartido backend <-> maminco-ai.
INTERNAL_SERVICE_TOKEN="dev-internal-token"
AI_SERVICE_URL="http://localhost:8000"

# ============================================
# LOGS / OBSERVABILIDAD
# ============================================
# Persistencia en PostgreSQL de los logs de la app.
LOG_DB_ENABLED=true
# Nivel mínimo que se persiste: verbose|debug|log|warn|error|fatal.
LOG_LEVEL=log
# Cada cuántos ms se vuelcan los logs en buffer a la base de datos.
LOG_FLUSH_INTERVAL_MS=2000
# Retención: se eliminan logs más antiguos que estos días (cron diario 03:00).
LOG_RETENTION_DAYS=3
# Tope de filas; se eliminan las más antiguas por encima de este límite.
LOG_MAX_ROWS=20000
