# ============================================
# DATABASE
# ============================================
# PostgreSQL (local o Docker). Requerido.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maminco_dev?schema=public"

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# AUTH (REQUERIDO)
# ============================================
# Obligatorio. Mínimo 32 caracteres. La app no arranca sin esto.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=12h

# ============================================
# CORS
# ============================================
# Lista separada por comas. Si se omite, usa localhost por defecto.
# CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# ============================================
# SERVICIO DE IA (opcional por ahora)
# ============================================
# Token compartido backend <-> maminco-ai.
INTERNAL_SERVICE_TOKEN="dev-internal-token"
AI_SERVICE_URL="http://localhost:8000"

# ============================================
# LOGS / OBSERVABILIDAD
# ============================================
# Persistencia en PostgreSQL de los logs de la app.
LOG_DB_ENABLED=true
# Nivel mínimo que se persiste: verbose|debug|log|warn|error|fatal.
LOG_LEVEL=log
# Cada cuántos ms se vuelcan los logs en buffer a la base de datos.
LOG_FLUSH_INTERVAL_MS=2000
# Retención: se eliminan logs más antiguos que estos días (cron diario 03:00).
LOG_RETENTION_DAYS=3
# Tope de filas; se eliminan las más antiguas por encima de este límite.
LOG_MAX_ROWS=20000

# ============================================
# REPORTES
# ============================================
# Zona horaria que define el "día" de ventas en reportes.
REPORT_TIMEZONE=America/La_Paz

# --- Insights / agentes (MCP) ---
# Orden de proveedores de modelo; si ninguno responde se usa el motor local determinista.
LLM_PROVIDERS="opencode"
OPENCODE_API_KEY=""
OPENCODE_BASE_URL="https://opencode.ai/inference/go"
OPENCODE_CHAT_PATH="/openai/v1/chat/completions"
OPENCODE_MODEL="deepseek-v4.1-flash"
OPENCODE_TIMEOUT_MS=60000
# Proveedor adicional compatible con la API de OpenAI (opcional; añádelo a LLM_PROVIDERS como "custom").
# CUSTOM_LLM_BASE_URL=""
# CUSTOM_LLM_MODEL=""
# CUSTOM_LLM_API_KEY=""

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Object storage. "local" writes to UPLOADS_DIR with the same key layout as S3:
#   uploads/products/...  public product images (served at /uploads/products)
#   uploads/reports/...   private repository documents (never served statically)
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
# Public base URL of the images (local: this API's /uploads; production: the CloudFront domain).
ASSETS_BASE_URL="http://localhost:3000/uploads"
# Only when STORAGE_DRIVER="s3":
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_KEY_PREFIX=""

# Base URL the browser uses to reach this API; used for signed local download links of the repository.
PUBLIC_API_URL="http://localhost:3000"
