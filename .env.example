# ============================================
# DATABASE CONFIGURATION
# ============================================
# Opción 1: PostgreSQL Local (recomendado para producción)
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/maminco_dev?schema=public"

# Opción 2: PostgreSQL con Docker
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maminco_dev?schema=public"

# Opción 3: SQLite (rápido, sin servidor, útil para desarrollo local)
# DATABASE_URL="file:./dev.db"

# Opción 4: Prisma Postgres (Cloud managed)
# DATABASE_URL="postgresql://user:password@aws-0-us-east-1.pooling.prisma.io:5432/maminco_db"

# Reemplaza con tu DATABASE_URL real:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maminco_dev?schema=public"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# AUTHENTICATION (opcional para después)
# ============================================
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRES_IN=7d
